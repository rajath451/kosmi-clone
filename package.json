{
  "name": "kosmi-clone",
  "version": "1.0.0",
  "description": "A browser-based watch party and virtual hangout platform",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "nodemon --exec node server.js",
    "client:dev": "cd client && npm run dev",
    "server:start": "node server.js",
    "client:build": "cd client && npm run build",
    "build": "npm run client:build",
    "install:all": "npm install && cd client && npm install"
  },
  "keywords": ["watch-party", "video-sync", "hangout", "gaming"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "socket.io": "^4.7.2",
    "dotenv": "^16.3.1",
    "uuid": "^9.0.1",
    "cors": "^2.8.5"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "concurrently": "^8.2.2"
  }
}
